+__global__ void transpose_obs_wide(precision_t* dst, const precision_t* src,
+        int A, int B, int C) {
+    long idx = (long)blockIdx.x * blockDim.x + threadIdx.x;
+    long total = (long)A * B * C;
+    if (idx >= total) return;
+    long a = idx / ((long)B * C);
+    long rem = idx % ((long)B * C);
+    long b = rem / C;
+    long c = rem % C;
+    dst[b * A * C + a * C + c] = src[idx];
+}
