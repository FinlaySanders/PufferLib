+// Exercise the actual PPO kernels, including outcome gating and old-logprob
+// finalization. Returns loss, entropy, target gradient, ratio, and new logprob.
+void nh_identify_ppo(int used, float target_logit, float* result) {
+    int hs[] = ACT_SIZES, A = NH_DEC_OD;
+    float* mem; cudaMallocManaged(&mem, (6*A + NUM_ATNS + 128)*sizeof(float));
+    memset(mem, 0, (6*A + NUM_ATNS + 128)*sizeof(float));
+    float* logits=mem; float* mask=logits+A+1; float* acts=mask+A;
+    float* grad=acts+NUM_ATNS; float* oldlp=grad+A; float* imp=oldlp+1;
+    float* value=imp+1; float* newlp=value+1; float* parts=newlp+1;
+    float* adv=parts+2; float* ret=adv+1; float* ent=ret+1;
+    float* losses=ent+1;
+    int* sizes; cudaMallocManaged(&sizes,sizeof(hs)); memcpy(sizes,hs,sizeof(hs));
+    int nv,na; const signed char* host=env_head_consume_map(&nv,&na);
+    signed char* map; cudaMalloc(&map,nv*na);
+    cudaMemcpy(map,host,nv*na,cudaMemcpyHostToDevice);
+    cudaMemcpyToSymbol(d_hc_dev,&map,sizeof(map)); cudaMemcpyToSymbol(d_hc_stride,&na,sizeof(na));
+    for(int i=0;i<A;i++) mask[i]=1;
+    acts[0]=NETHACK_ACT_READ; acts[NETHACK_IDENTIFY_HEAD]=used ? 0 : -1;
+    int offset=NETHACK_NUM_ACTIONS+12*NETHACK_INV_SLOTS;
+    logits[offset]=target_logit;
+    parts[0]=-logf(NETHACK_NUM_ACTIONS)-logf(NETHACK_INV_SLOTS);
+    parts[1]=-logf(NETHACK_INV_SLOTS);
+    nethack_finish_logprobs<<<1,32>>>(acts,parts,oldlp,1);
+    Prec dec={.data=logits,.shape={1,1,A+1}}, empty={};
+    cache_imp_and_v<<<1,32>>>(dec,acts,oldlp,mask,empty,sizes,imp,value,grad,newlp);
+    cudaDeviceSynchronize();
+    float saved_lp=*newlp, saved_ratio=*imp;
+    *adv=1; *ent=0.1f;
+    PPOKernelArgs ka={}; ka.grad_logits=grad; ka.grad_values_pred=newlp;
+    ka.logits=logits; ka.values_pred=logits+A; ka.act_sizes=sizes;
+    ka.action_mask=mask; ka.num_atns=NUM_ATNS; ka.clip_coef=0.2f;
+    ka.vf_clip_coef=0.2f; ka.ent_coef=ent; ka.T_seq=1; ka.A_total=A; ka.N=1;
+    PPOGraphArgs ga={.imp=imp,.actions=acts,.old_logprobs=oldlp,
+        .advantages=adv,.values=value,.returns=ret};
+    ppo_loss_compute<<<1,PPO_THREADS>>>(losses,ka,ga);
+    assert(cudaDeviceSynchronize()==cudaSuccess);
+    result[0]=losses[LOSS_TOTAL]; result[1]=losses[LOSS_ENT];
+    result[2]=grad[offset]; result[3]=saved_ratio; result[4]=saved_lp;
+    float maxg=0; for(int i=0;i<NETHACK_INV_SLOTS;i++) maxg=fmaxf(maxg,fabsf(grad[offset+i]));
+    result[5]=maxg;
+    signed char* nil=NULL;cudaMemcpyToSymbol(d_hc_dev,&nil,sizeof(nil));
+    cudaFree(map);cudaFree(sizes);cudaFree(mem);
+}
+
+int nh_identify_live(int (*prepare)(nle_ctx_t*), int (*check)(nle_ctx_t*)) {
+    Nethack env = {};
+    env.rng = 7; env.num_agents = 1;
+    Agent* a = &env.agents[0];
+    a->observations = (unsigned char*)calloc(OBS_SIZE, 1);
+    a->actions = (float*)calloc(NUM_ATNS, sizeof(float));
+    int sizes[] = ACT_SIZES, total = 0;
+    for (int i=0;i<NUM_ATNS;i++) total += sizes[i];
+    a->action_mask = (unsigned char*)calloc(total, 1);
+    a->rewards = (float*)calloc(1,sizeof(float));
+    a->terminals = (float*)calloc(1,sizeof(float));
+    init(&env); nethack_sync_buffers(&env); nethack_do_reset(&env);
+    int letters = prepare(env.ctx);
+    nle_obs_refresh(env.ctx, &env.obs);
+    int scroll = -1, target = -1;
+    for (int i=0;i<NETHACK_INV_SLOTS;i++) {
+        if (env.inv_letters[i] == (letters & 255)) scroll=i;
+        if (env.inv_letters[i] == (letters >> 8)) target=i;
+    }
+    int result = -1;
+    if (scroll >= 0 && target >= 0) {
+        a->actions[NETHACK_IDENTIFY_HEAD] = target;
+        int bad = 0;
+        nethack_execute(&env,NETHACK_ACT_READ,scroll,0,&bad);
+        nethack_handle_prompts(&env);
+        result = bad ? -2 : check(env.ctx);
+    }
+    puf_close(&env);
+    free(a->observations); free(a->actions); free(a->action_mask);
+    free(a->rewards); free(a->terminals);
+    return result;
+}
