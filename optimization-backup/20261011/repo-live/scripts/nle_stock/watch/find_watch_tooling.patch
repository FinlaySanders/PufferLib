     unsigned char chars[NH_GRID]; // render only: bound when a renderer asks
+    long ep_ordinal; // episodes finished on this env (NH_EPLOG / NH_WATCH_EP)
+    FILE* actf; long act_off; // NH_ACTLOG: per-env action stream, byte offset of the current episode
     short glyphs_local[NH_GRID]; // glyph backing when no observation slot is bound
