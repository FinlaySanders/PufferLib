 // Interactive: press space = 1 action; hold = 5/s; shift+space (or S) = 20/s.
 static void run_demo_interactive(long max_steps) {
     const char* wpath = demo_find_weights();
@@ -1531,6 +1232,47 @@ static void run_demo_auto(long max_steps, int frame_ms) {
 // ./nethack N 0              headless N steps
 // ./nethack N MS             auto-run N steps at MS ms/frame
 // NH_WEIGHTS=... NH_SEED=...
+// NH_REPLAY_DIR/ENV/EP/OFF/N: replay one recorded eval episode (NH_ACTLOG) through the same puf_step,
+// drawn by the in-step watch hook. Episode K's seed is the LCG advanced K times, so the skip is instant.
+static void run_replay(int frame_ms) {
+    const char* dir = getenv("NH_REPLAY_DIR");
+    unsigned envi = (unsigned)atol(getenv("NH_REPLAY_ENV")); long ep = atol(getenv("NH_REPLAY_EP"));
+    long off = atol(getenv("NH_REPLAY_OFF")), n = atol(getenv("NH_REPLAY_N"));
+    long skip = getenv("NH_SKIP") ? atol(getenv("NH_SKIP")) : 0;
+    char path[600]; snprintf(path, sizeof(path), "%s/env%u.act", dir, envi);
+    FILE* f = fopen(path, "rb");
+    if (!f || fseek(f, off, SEEK_SET) != 0) { fprintf(stderr, "replay: cannot open %s @%ld\n", path, off); exit(1); }
+    nethack_color_sink = demo_colors; nethack_invstr_sink = demo_inv_strs;
+    srand(1);
+    Nethack env; env_open(&env);
+    { // NH_REPLAY_BIND bitmask (default 7): 1 chars, 2 colors, 4 inv_strs -- to diagnose RNG-consuming observation fills
+        int b = getenv("NH_REPLAY_BIND") ? atoi(getenv("NH_REPLAY_BIND")) : 7;
+        nethack_want_chars = (b & 1) != 0; nethack_color_sink = (b & 2) ? demo_colors : NULL; nethack_invstr_sink = (b & 4) ? demo_inv_strs : NULL;
+    }
+    env.rng = envi; env.seed = 0xCAFEBEEFUL + envi; // the eval's chain: reset K times to reach episode K
+    for (long k = 0; k < ep; k++) nethack_do_reset(&env);
+    env.ep_ordinal = ep - 1;
+    nethack_watch_init();
+    nethack_watch_env = envi; nethack_watch_ms = frame_ms; nethack_watch_stop = 0;
+    fprintf(stderr, "replay: env %u episode %ld, %ld steps from %s@%ld\n", envi, ep, n, path, off);
+    float* act = env.agents[0].actions; long stepped = 0;
+    for (long t = 0; t < n; t++) {
+        unsigned char rec[3];
+        if (fread(rec, 1, 3, f) != 3) break;
+        memset(act, 0, 20 * sizeof(float));
+        int verb = rec[0], head = NETHACK_VERBS[verb].head, dh = nethack_dir_head(verb);
+        act[0] = (float)verb;
+        if (verb == NETHACK_ACT_CAST) act[19] = rec[1]; else if (head >= 0) act[1 + head] = rec[1];
+        if (dh >= 0) act[13 + dh] = rec[2];
+        nethack_watch_ep = ep; nethack_watch_quiet = !(frame_ms > 0 && t >= skip); // draw only past NH_SKIP
+        puf_step(&env); stepped = t + 1;
+        if (env.ep_ordinal >= ep) break; // the hook printed EPISODE OVER on the terminal step
+    }
+    fprintf(stderr, "replay: stepped %ld of %ld, episode %s\n", stepped, n, env.ep_ordinal >= ep ? "ended" : "DID NOT END");
+    fclose(f);
+    env_close(&env);
+}
+
 int main(int argc, char** argv) {
     long max_steps = (argc >= 2) ? atol(argv[1]) : 1000000;
     int interactive = isatty(STDIN_FILENO);
@@ -1541,6 +1283,7 @@ int main(int argc, char** argv) {
     } else if (!interactive) {
         frame_ms = 0; // piped/non-TTY default: headless auto-run
     }
+    if (getenv("NH_REPLAY_DIR")) { run_replay(frame_ms); return 0; }
     if (interactive) run_demo_interactive(max_steps);
     else run_demo_auto(max_steps, frame_ms);
     return 0;
