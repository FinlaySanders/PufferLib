@@ -155,6 +158,22 @@ static unsigned char* nethack_tty_cursor_sink;
 static const char* nethack_options_override; // demo-only; NULL = default options
 
 static int nethack_want_chars; // renderers/demo bind the char grid; training leaves it unfilled
+// NH_WATCH_ENV=<env idx> NH_WATCH_EP=<1-based episode on that env>: draw that episode from inside the
+// headless eval (everything else runs at full speed); NH_WATCH_MS pacing; NH_WATCH_STOP exits after it
+static long nethack_watch_env = -1, nethack_watch_ep, nethack_watch_ms = 40, nethack_watch_stop;
+static const char* nethack_actlog_dir;
+static int nethack_watch_quiet; // replay while skipping: report the outcome, draw nothing // NH_ACTLOG=<dir>: record every step's (verb, slot, dir) per env for offline replay
+static void nethack_watch_init(void) {
+    static int done; if (done) return; done = 1; const char* v;
+    nethack_watch_env = (v = getenv("NH_WATCH_ENV")) ? atol(v) : -1;
+    nethack_watch_ep = (v = getenv("NH_WATCH_EP")) ? atol(v) : 0;
+    nethack_watch_ms = (v = getenv("NH_WATCH_MS")) ? atol(v) : 40;
+    nethack_watch_stop = getenv("NH_WATCH_STOP") != NULL;
+    nethack_actlog_dir = getenv("NH_ACTLOG");
+    if (nethack_actlog_dir) mkdir(nethack_actlog_dir, 0755);
+    if (nethack_watch_env >= 0 || getenv("NH_WANT_CHARS")) nethack_want_chars = 1;
+}
+static void nethack_watch_draw(Nethack* env, int done); // defined after the shared view below
