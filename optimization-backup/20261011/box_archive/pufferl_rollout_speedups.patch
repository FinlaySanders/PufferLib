+#ifdef PUF_SAMPLE_WARP
+// Warp-per-agent discrete sampler (NetHack path). Same math and the same
+// per-agent RNG draw order as sample_logits (one curand_uniform per head,
+// drawn by lane 0), with the per-head logsumexp, CDF and legal-count work
+// spread across the 32 lanes instead of one thread walking 742 logits.
+// Numerically equivalent up to float summation order; not bit-identical.
+__global__ void sample_logits_warp(
+        Prec dec_out, int* act_sizes, float* actions, float* env_actions,
+        precision_t* logprobs, precision_t* value_out,
+        curandStatePhilox4_32_10_t* rng_states, precision_t* action_mask,
+        int mask_stride) {
+    int B = dec_out.shape[0];
+    int fused_cols = dec_out.shape[1];
+    int num_atns = NUM_ATNS;
+    precision_t* logits = dec_out.data;
+    int lane = threadIdx.x & 31;
+    int idx = (blockIdx.x * blockDim.x + threadIdx.x) >> 5;
+    if (idx >= B) return;
+    const unsigned FULL = 0xffffffffu;
+    curandStatePhilox4_32_10_t state;
+    if (lane == 0) state = rng_states[idx];
+    int logits_base = idx * fused_cols;
+    int mask_base = idx * mask_stride;
+    float total_log_prob = 0.0f;
+    int logits_offset = 0;
+    int verb0 = 0;
+    for (int h = 0; h < num_atns; h++) {
+        int A = act_sizes[h];
+        // lanes hold a = lane and a = lane + 32 (A <= 64)
+        float l0 = -INFINITY, l1 = -INFINITY;
+        float m0 = 0.0f, m1 = 0.0f;
+        if (lane < A) {
+            m0 = to_float(action_mask[mask_base + logits_offset + lane]);
+            l0 = to_float(logits[logits_base + logits_offset + lane]);
+            if (m0 == 0.0f) l0 = -1e4f;
+        }
+        if (lane + 32 < A) {
+            m1 = to_float(action_mask[mask_base + logits_offset + lane + 32]);
+            l1 = to_float(logits[logits_base + logits_offset + lane + 32]);
+            if (m1 == 0.0f) l1 = -1e4f;
+        }
+        float mx = fmaxf(l0, l1);
+        for (int o = 16; o > 0; o >>= 1) mx = fmaxf(mx, __shfl_xor_sync(FULL, mx, o));
+        float e0 = (lane < A) ? __expf(l0 - mx) : 0.0f;
+        float e1 = (lane + 32 < A) ? __expf(l1 - mx) : 0.0f;
+        float sum = e0 + e1;
+        for (int o = 16; o > 0; o >>= 1) sum += __shfl_xor_sync(FULL, sum, o);
+        float lse = mx + __logf(sum);
+        float eps = 0.0f, inv_K = 0.0f;
+#ifdef PUFFER_NETHACK
+        if (h == 0) {
+            if (lane == 0)
+                eps = nethack_verb_eps_load(action_mask + mask_base + logits_offset, A, &inv_K);
+            eps = __shfl_sync(FULL, eps, 0);
+            inv_K = __shfl_sync(FULL, inv_K, 0);
+        }
+#endif
+        float rand_val = 0.0f;
+        if (lane == 0) rand_val = curand_uniform(&state);
+        rand_val = __shfl_sync(FULL, rand_val, 0);
+        // probabilities in the same (eps-mixed) form as the serial CDF walk
+        float p0 = __expf(l0 - lse), p1 = __expf(l1 - lse);
+        if (lane >= A) p0 = 0.0f;
+        if (lane + 32 >= A) p1 = 0.0f;
+#ifdef PUFFER_NETHACK
+        if (eps > 0.0f) {
+            if (lane < A) p0 = (1.0f - eps) * p0 + eps * (m0 != 0.0f ? 1.0f : 0.0f) * inv_K;
+            if (lane + 32 < A) p1 = (1.0f - eps) * p1 + eps * (m1 != 0.0f ? 1.0f : 0.0f) * inv_K;
+        }
+#endif
+        // inclusive prefix sums in action order: a = 0..31 then 32..63
+        float c0 = p0;
+        for (int o = 1; o < 32; o <<= 1) { float t = __shfl_up_sync(FULL, c0, o); if (lane >= o) c0 += t; }
+        float tot0 = __shfl_sync(FULL, c0, 31);
+        float c1 = p1;
+        for (int o = 1; o < 32; o <<= 1) { float t = __shfl_up_sync(FULL, c1, o); if (lane >= o) c1 += t; }
+        c1 += tot0;
+        // first a with rand < cumsum(a); fall-through -> A - 1
+        int cand = A - 1;
+        if (lane + 32 < A && rand_val < c1) cand = lane + 32;
+        if (lane < A && rand_val < c0) cand = lane;
+        for (int o = 16; o > 0; o >>= 1) cand = min(cand, __shfl_xor_sync(FULL, cand, o));
+        int sampled = cand;
+        if (sampled == A - 1) { // snap to the last legal action (exact no-op if legal)
+            int lg = -1;
+            if (lane + 32 < A && m1 != 0.0f) lg = lane + 32;
+            else if (lane < A && m0 != 0.0f) lg = lane;
+            for (int o = 16; o > 0; o >>= 1) lg = max(lg, __shfl_xor_sync(FULL, lg, o));
+            if (lg >= 0) sampled = lg;
+        }
+        if (h == 0) verb0 = sampled;
+        float ls = __shfl_sync(FULL, (sampled < 32) ? l0 : l1, sampled & 31);
+        float ms = __shfl_sync(FULL, (sampled < 32) ? m0 : m1, sampled & 31);
+        if (lane == 0) {
+            int aidx = idx * num_atns + h;
+            float action = (float) sampled;
+            actions[aidx] = action;
+            env_actions[aidx] = action;
+#ifdef PUFFER_NETHACK
+            if (nethack_head_used(verb0, h)) {
+                if (eps > 0.0f)
+                    total_log_prob += logf((1.0f - eps) * __expf(ls - lse) + eps * inv_K);
+                else
+                    total_log_prob += ls - lse;
+            }
+#else
+            total_log_prob += ls - lse;
+#endif
+            (void) ms;
+        }
+        logits_offset += A;
+    }
+    if (lane == 0) {
+        logprobs[idx] = from_float(total_log_prob);
+        value_out[idx] = logits[logits_base + fused_cols - 1];
+        rng_states[idx] = state;
+    }
+}
+#endif
+
