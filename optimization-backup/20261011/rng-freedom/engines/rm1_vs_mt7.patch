 {
-    return (isaac64_next_uint64(nle_rng_state(DISP)) % x);
+    return (int) ((unsigned __int128) isaac64_next_uint64(nle_rng_state(DISP)) * (uint64_t) x >> 64);
 }
 
 #else   /* USE_ISAAC64 */
