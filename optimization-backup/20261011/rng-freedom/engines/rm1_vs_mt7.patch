+    int r = (int) ((unsigned __int128) isaac64_next_uint64(nle_rng_state(CORE)) * (uint64_t) x >> 64);
 
     return nle_rng_trace("RND", x, r);
 }
@@ -101,7 +102,7 @@
 rn2_on_display_rng(x)
