diff -ru mt7/source/src/rnd.c rm1/source/src/rnd.c
--- mt7/source/src/rnd.c	2026-09-13 13:53:56.000000000 +0000
+++ rm1/source/src/rnd.c	2026-10-11 15:25:30.199020643 +0000
@@ -89,7 +89,8 @@
 static int
 RND(int x)
 {
-    int r = (int) (isaac64_next_uint64(nle_rng_state(CORE)) % x);
