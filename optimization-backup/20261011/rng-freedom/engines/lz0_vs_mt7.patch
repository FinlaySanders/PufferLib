+        bit = __builtin_ctz(cand);
+        cand &= cand - 1;
+        nx = c.x - 1 + bit / 3;
+        ny = c.y - 1 + bit % 3;
+        if (nh_mfnd_cell(&c, nx, ny, &info[cnt])) {
+            poss[cnt].x = nx;
+            poss[cnt].y = ny;
+            cnt++;
         }
