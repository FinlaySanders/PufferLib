+// ===================== cache-affine scheduler path (PUF_SCHED=1) =====================
+// Inference runs on "slots" (the per-buffer graph machinery, rows = whichever agents are ready); per-agent recurrent state and
+// sampler RNG are gathered into the slot before the forward and scattered back after, so agent i always sees its own state and
+// RNG stream regardless of which slot/row forwards it. Outputs are scattered to (time, agent) in the rollout buffer.
+__global__ void sched_gather_state(Prec dst, Prec src, const int* idx, int R, int scratch) {
+    int L = dst.shape[0], H = dst.shape[2], A = (int)src.shape[1]; long total = (long)L * R * H;
+    for (long i = blockIdx.x * (long)blockDim.x + threadIdx.x; i < total; i += (long)gridDim.x * blockDim.x) {
+        int h = i % H, r = (i / H) % R, layer = i / ((long)R * H); int a = idx[r]; if (a < 0) a = scratch;
+        dst.data[state_elem_idx(layer, R, r, h, H)] = src.data[state_elem_idx(layer, A, a, h, H)];
+    }
+}
+__global__ void sched_scatter_state(Prec dst, Prec src, const int* idx, int R) {
+    int L = src.shape[0], H = src.shape[2], A = (int)dst.shape[1]; long total = (long)L * R * H;
+    for (long i = blockIdx.x * (long)blockDim.x + threadIdx.x; i < total; i += (long)gridDim.x * blockDim.x) {
+        int h = i % H, r = (i / H) % R, layer = i / ((long)R * H); int a = idx[r]; if (a < 0) continue;
+        dst.data[state_elem_idx(layer, A, a, h, H)] = src.data[state_elem_idx(layer, R, r, h, H)];
+    }
+}
+// Snapshot the (terminal-zeroed) state of rows at t==0 of their segment into initial_states[slot] (slot = tt / horizon).
+__global__ void sched_snapshot_state(Prec full, Prec src, const int* idx, const int* tt, int R, int horizon) {
+    int L = src.shape[0], H = src.shape[2], A = (int)full.shape[2]; long stride = (long)L * A * H; long total = (long)L * R * H;
+    for (long i = blockIdx.x * (long)blockDim.x + threadIdx.x; i < total; i += (long)gridDim.x * blockDim.x) {
+        int h = i % H, r = (i / H) % R, layer = i / ((long)R * H); int a = idx[r]; if (a < 0 || tt[r] % horizon) continue;
+        full.data[(long)(tt[r] / horizon) * stride + state_elem_idx(layer, A, a, h, H)] = src.data[state_elem_idx(layer, R, r, h, H)];
+    }
+}
+__global__ void sched_gather_rng(curandStatePhilox4_32_10_t* dst, const curandStatePhilox4_32_10_t* src, const int* idx, int R, int scratch) {
+    int r = blockIdx.x * blockDim.x + threadIdx.x; if (r >= R) return; int a = idx[r]; if (a < 0) a = scratch; dst[r] = src[a];
+}
+__global__ void sched_scatter_rng(curandStatePhilox4_32_10_t* dst, const curandStatePhilox4_32_10_t* src, const int* idx, int R) {
+    int r = blockIdx.x * blockDim.x + threadIdx.x; if (r >= R) return; int a = idx[r]; if (a < 0) return; dst[a] = src[r];
+}
+// Slot rows → rollouts[(tt[r], idx[r])]; tt is the absolute time row (write_slot*horizon + t). Padded rows (idx < 0) are skipped.
+__global__ void sched_record_scatter(StepRecord dst, StepRecord src, const int* idx, const int* tt, int R, int B, int Op, int Mp, int Ap) {
+    int maxp = max(Op, max(Mp, Ap)); long total = (long)R * maxp;
+    for (long i = blockIdx.x * (long)blockDim.x + threadIdx.x; i < total; i += (long)gridDim.x * blockDim.x) {
+        int r = i / maxp, e = i % maxp; int a = idx[r]; if (a < 0) continue; long row = (long)tt[r] * B + a;
+        if (e < Op) dst.obs[row * Op + e] = src.obs[(long)r * Op + e];
+        if (e < Mp) dst.mask[row * Mp + e] = src.mask[(long)r * Mp + e];
+        if (e < Ap) dst.actions[row * Ap + e] = src.actions[(long)r * Ap + e];
+        if (e == 0) { dst.lp[row] = src.lp[r]; dst.val[row] = src.val[r]; dst.rew[row] = src.rew[r]; dst.term[row] = src.term[r]; }
+    }
+}
+// Zero-copy gather: slot rows ← host (pinned, mapped) agent rows by index; padded rows get zero obs/rew/term and an all-ones mask.
+__global__ void sched_gather_inputs(obs_t* d_obs, float* d_rew, float* d_term, unsigned char* d_mask,
+        const obs_t* h_obs, const float* h_rew, const float* h_term, const unsigned char* h_mask, const int* idx, int R, int obs_size, int mask_size) {
+    int r = blockIdx.x; int a = idx[r];
+    const unsigned short* src = a >= 0 ? (const unsigned short*)(h_obs + (size_t)a * obs_size) : NULL; unsigned short* dst = (unsigned short*)(d_obs + (size_t)r * obs_size);
+    int n2 = obs_size / 2; /* obs_size is even (checked at setup): 2-byte units halve the PCIe transactions of a byte gather */
+    for (int i = threadIdx.x; i < n2; i += blockDim.x) dst[i] = src ? src[i] : (unsigned short)0;
+    for (int i = threadIdx.x; i < mask_size; i += blockDim.x) d_mask[(size_t)r * mask_size + i] = a >= 0 ? h_mask[(size_t)a * mask_size + i] : 1;
+    if (threadIdx.x == 0) { d_rew[r] = a >= 0 ? h_rew[a] : 0.f; d_term[r] = a >= 0 ? h_term[a] : 0.f; }
+}
+static void sched_forward_body(PuffeRL* p, int s, cudaStream_t stream) {
+    VecEnv* vec = p->vec; int R = vec->agents_per_buf, start = s * R, H = p->hypers.horizon;
+    Policy* pol = &p->policies[0]; Prec* st = &pol->buffer_states[s];
+    int state_n = (int)st->shape[0] * R * (int)st->shape[2];
+    if (vec->sched_zero_copy) {
+        EnvBuf* e = &p->env;
+        sched_gather_inputs<<<R, 256, 0, stream>>>(e->obs.data + (size_t)start * OBS_SIZE, e->rewards.data + start, e->terminals.data + start,
+            e->action_mask.data + (size_t)start * vec->mask_size, vec->dh_obs, vec->dh_rew, vec->dh_term, vec->dh_mask, vec->d_idx[s], R, OBS_SIZE, vec->mask_size);
+    }
+    sched_gather_state<<<grid_size(state_n), BLOCK_SIZE, 0, stream>>>(*st, p->sched_state, vec->d_idx[s], R, 0);
+    sched_gather_rng<<<grid_size(R), BLOCK_SIZE, 0, stream>>>(p->rng_states[s], p->sched_rng, vec->d_idx[s], R, 0);
+    zero_term_state<<<grid_size(state_n), BLOCK_SIZE, 0, stream>>>(*st, p->env.terminals, 0, start, R);
+    if (p->rollouts.initial_states.data)
+        sched_snapshot_state<<<grid_size(state_n), BLOCK_SIZE, 0, stream>>>(p->rollouts.initial_states, *st, vec->d_idx[s], vec->d_tt[s], R, H);
+    pufferl_forward_step(p, s, 0, stream);
+    sched_scatter_state<<<grid_size(state_n), BLOCK_SIZE, 0, stream>>>(p->sched_state, *st, vec->d_idx[s], R);
+    sched_scatter_rng<<<grid_size(R), BLOCK_SIZE, 0, stream>>>(p->sched_rng, p->rng_states[s], vec->d_idx[s], R);
+    RolloutBuf& ro = p->rollouts;
+    StepRecord dst = {ro.observations.data, ro.action_mask.data, ro.logprobs.data, ro.values.data, ro.rewards.data, ro.terminals.data, ro.actions.data};
+    StepRecord src = record_view(p->step_rollouts, 0, start, R);
+    int Op = p->step_rollouts.observations.shape[2], Mp = p->step_rollouts.action_mask.shape[2], Ap = p->step_rollouts.actions.shape[2];
+    sched_record_scatter<<<grid_size(R * max(Op, max(Mp, Ap))), BLOCK_SIZE, 0, stream>>>(dst, src, vec->d_idx[s], vec->d_tt[s], R, p->hypers.total_agents, Op, Mp, Ap);
+}
+static void sched_env_step(void* ctx, int a) { PuffeRL* p = (PuffeRL*)ctx; VecEnv* vec = p->vec; vec->rewards[a] = 0; vec->terminals[a] = 0; puf_step(&vec->envs[a]); }
+// Recorded-action replay (PUF_ACTION_REPLAY): agent a at its own step t takes frame (segments_done*horizon + t) of stream a / (agents/4), slot a % 128.
+static void sched_before_step(void* ctx, int a, int t) {
+    PuffeRL* p = (PuffeRL*)ctx; VecEnv* vec = p->vec; if (!vec->replay[0]) return;
+    int stream = a / (vec->total_agents / 4), slot = a % 128;
+    size_t frame = (size_t)(vec->sched_segments - 1) * p->hypers.horizon + t;
+    size_t off = (frame * 128 + slot) * NUM_ATNS * sizeof(float);
+    assert(off + NUM_ATNS * sizeof(float) <= vec->replay_size);
+    memcpy(vec->actions + (size_t)a * NUM_ATNS, vec->replay[stream] + off, NUM_ATNS * sizeof(float));
+}
+typedef struct { PuffeRL* p; int slot; } SchedSlotArg;
+static void* sched_slot_main(void* arg) {
+    SchedSlotArg* a = (SchedSlotArg*)arg; PuffeRL* p = a->p; VecEnv* vec = p->vec; int s = a->slot;
+    cudaSetDevice(p->hypers.gpu_id); cublas_init_handle();
+    cudaStream_t stream = p->streams[s]; cublas_init_stream(stream);
+    if (getenv("PUF_CPU_AFFINITY") && s < 8) ep_pin_cpu(2 * s + 1); /* P-core SMT siblings, like the pool's submitters */
+    int R = vec->agents_per_buf, H = p->hypers.horizon; long mask = vec->mask_size; EnvSched* es = vec->sched;
+    int* idx = vec->st_idx[s]; int* tt = vec->st_tt[s]; obs_t* sobs = vec->st_obs[s]; float* srew = vec->st_rew[s]; float* sterm = vec->st_term[s];
+    unsigned char* smask = vec->st_mask[s]; float* sact = vec->st_act[s]; EnvBuf* e = &p->env; int start = s * R;
+    memset(sobs, 0, (size_t)R * OBS_SIZE * sizeof(obs_t)); memset(smask, 1, (size_t)R * mask);
+    cudaGraphExec_t graph = NULL; double fwd_ewma = 350e-6;
+    long sleep_ns = getenv("PUF_SCHED_SLOT_SLEEP_US") ? atol(getenv("PUF_SCHED_SLOT_SLEEP_US")) * 1000L : 0;
+    for (;;) {
+        if (__atomic_load_n(&vec->shutdown, __ATOMIC_SEQ_CST)) return NULL;
+        if (!__atomic_load_n(&es->running, __ATOMIC_ACQUIRE)) { struct timespec ts = {0, 50000}; nanosleep(&ts, NULL); continue; }
+        double window = vec->sched_window > 0 ? vec->sched_window : fwd_ewma;
+        int n = es_infer_pop(es, idx, R, window);
+        if (!n) { if (sleep_ns) { struct timespec ts = {0, sleep_ns}; nanosleep(&ts, NULL); } else for (int i = 0; i < 16; i++) _mm_pause(); continue; }
+        int wslot = vec->sched_write_slot;
+        if (vec->sched_zero_copy) {
+            for (int r = 0; r < n; r++) tt[r] = wslot * H + es->agent[idx[r]].t;
+            for (int r = n; r < R; r++) { idx[r] = -1; tt[r] = wslot * H; }
+        } else {
+        for (int r = 0; r < n; r++) { int g = idx[r];
+            memcpy(sobs + (size_t)r * OBS_SIZE, vec->observations + (size_t)g * OBS_SIZE, OBS_SIZE * sizeof(obs_t));
+            srew[r] = vec->rewards[g]; sterm[r] = vec->terminals[g];
+            memcpy(smask + (size_t)r * mask, vec->action_mask + (size_t)g * mask, mask);
+            tt[r] = wslot * H + es->agent[g].t; }
+        for (int r = n; r < R; r++) { idx[r] = -1; tt[r] = wslot * H; srew[r] = 0; sterm[r] = 0; }
+        cudaMemcpyAsync(e->obs.data + (size_t)start * OBS_SIZE, sobs, (size_t)R * OBS_SIZE * sizeof(obs_t), cudaMemcpyHostToDevice, stream);
+        cudaMemcpyAsync(e->rewards.data + start, srew, R * sizeof(float), cudaMemcpyHostToDevice, stream);
+        cudaMemcpyAsync(e->terminals.data + start, sterm, R * sizeof(float), cudaMemcpyHostToDevice, stream);
+        cudaMemcpyAsync(e->action_mask.data + (size_t)start * mask, smask, (size_t)R * mask, cudaMemcpyHostToDevice, stream);
+        }
+        cudaMemcpyAsync(vec->d_idx[s], idx, R * sizeof(int), cudaMemcpyHostToDevice, stream);
+        cudaMemcpyAsync(vec->d_tt[s], tt, R * sizeof(int), cudaMemcpyHostToDevice, stream);
+        double f0 = es_now();
+        if (!graph) {
+            assert(cudaStreamBeginCapture(stream, cudaStreamCaptureModeThreadLocal) == cudaSuccess);
+            sched_forward_body(p, s, stream);
+            cudaGraph_t g; assert(cudaStreamEndCapture(stream, &g) == cudaSuccess);
+            assert(cudaGraphInstantiate(&graph, g, 0) == cudaSuccess); cudaGraphDestroy(g);
+        }
+        assert(cudaGraphLaunch(graph, stream) == cudaSuccess && "sched graph launch failed");
+        cudaMemcpyAsync(sact, e->actions.data + (size_t)start * NUM_ATNS, (size_t)R * NUM_ATNS * sizeof(float), cudaMemcpyDeviceToHost, stream);
+        assert(cudaStreamSynchronize(stream) == cudaSuccess);
+        double dt = es_now() - f0; fwd_ewma = 0.9 * fwd_ewma + 0.1 * dt; vec->sched_fwd_sum[s] += dt;
+        for (int r = 0; r < n; r++) memcpy(vec->actions + (size_t)idx[r] * NUM_ATNS, sact + (size_t)r * NUM_ATNS, NUM_ATNS * sizeof(float));
+        es_actions_back(es, idx, n);
+        vec->sched_forwards[s]++; vec->sched_rows[s] += n;
+    }
+}
+static void env_restart(PuffeRL* p);
+static void sched_setup(PuffeRL* p) {
