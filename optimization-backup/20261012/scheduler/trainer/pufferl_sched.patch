+        assert(cudaHostGetDevicePointer((void**)&vec->dh_obs, vec->observations, 0) == cudaSuccess);
+        assert(cudaHostGetDevicePointer((void**)&vec->dh_rew, vec->rewards, 0) == cudaSuccess);
+        assert(cudaHostGetDevicePointer((void**)&vec->dh_term, vec->terminals, 0) == cudaSuccess);
+        assert(cudaHostGetDevicePointer((void**)&vec->dh_mask, vec->action_mask, 0) == cudaSuccess);
