+        assert(cudaHostAlloc((void**)&vec->st_obs[s], (size_t)R * OBS_SIZE * sizeof(obs_t), cudaHostAllocPortable) == cudaSuccess);
+        assert(cudaHostAlloc((void**)&vec->st_rew[s], R * sizeof(float), cudaHostAllocPortable) == cudaSuccess);
+        assert(cudaHostAlloc((void**)&vec->st_term[s], R * sizeof(float), cudaHostAllocPortable) == cudaSuccess);
+        assert(cudaHostAlloc((void**)&vec->st_act[s], (size_t)R * NUM_ATNS * sizeof(float), cudaHostAllocPortable) == cudaSuccess);
+        assert(cudaHostAlloc((void**)&vec->st_mask[s], (size_t)R * mask, cudaHostAllocPortable) == cudaSuccess);
