+    vec->st_act = (float**)calloc(S, sizeof(float*)); vec->st_mask = (unsigned char**)calloc(S, sizeof(unsigned char*));
+    vec->st_idx = (int**)calloc(S, sizeof(int*)); vec->st_tt = (int**)calloc(S, sizeof(int*)); vec->d_idx = (int**)calloc(S, sizeof(int*)); vec->d_tt = (int**)calloc(S, sizeof(int*));
