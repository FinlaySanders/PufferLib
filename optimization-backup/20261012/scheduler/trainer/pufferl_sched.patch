+    assert(vec->size == vec->total_agents && "PUF_SCHED assumes one agent per env");
+    assert(p->num_policies == 1 && "PUF_SCHED: single policy only");
+    env_restart(p);
+    int workers = getenv("PUF_POOL_WORKERS") ? atoi(getenv("PUF_POOL_WORKERS")) : 24;
+    int pin = getenv("PUF_CPU_AFFINITY") ? atoi(getenv("PUF_CPU_AFFINITY")) : 0;
+    vec->sched_slots = getenv("PUF_SCHED_SLOTS") ? atoi(getenv("PUF_SCHED_SLOTS")) : (vec->buffers < 4 ? vec->buffers : 4);
+    assert(vec->sched_slots >= 1 && vec->sched_slots <= vec->buffers);
+    vec->sched_window = getenv("PUF_SCHED_WINDOW_US") ? atof(getenv("PUF_SCHED_WINDOW_US")) * 1e-6 : 0.0;
+    vec->sched_zero_copy = getenv("PUF_SCHED_ZERO_COPY") ? atoi(getenv("PUF_SCHED_ZERO_COPY")) : 1;
+    if (vec->sched_zero_copy) {
+        assert(OBS_SIZE % 2 == 0 && sizeof(obs_t) == 1 && "zero-copy gather copies 2-byte units");
