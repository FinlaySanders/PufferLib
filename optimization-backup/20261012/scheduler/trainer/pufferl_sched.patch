+}
+static void sched_segment_begin(PuffeRL* p) { VecEnv* vec = p->vec; vec->sched_write_slot = p->write_slot; vec->sched_segments++; es_segment_start(vec->sched); }
+static void sched_segment_end(PuffeRL* p, double t0) {
