+        rng_init<<<grid_size(R), BLOCK_SIZE>>>(p->sched_rng + (size_t)i * R, p->seed + (ref ? 0 : i), R, i * R, ref); /* same per-agent streams as the pool's rng_states[i][row] */
+    int S = vec->sched_slots; long mask = vec->mask_size;
