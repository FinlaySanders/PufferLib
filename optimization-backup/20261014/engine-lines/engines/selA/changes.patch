+++ engines/selA/source/include/movement_masks.h	2026-10-14 08:29:53.455629170 +0000
@@ -42,6 +42,7 @@
 {
     unsigned int dx = (unsigned int) (px - x + 1);
     unsigned int dy = (unsigned int) (py - y + 1);
-    return dx < 3 && dy < 3 ? 1U << (3 * dx + dy) : 0U;
