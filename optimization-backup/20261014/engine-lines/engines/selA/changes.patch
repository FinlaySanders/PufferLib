@@ -1321,15 +1321,18 @@
                             goto nxti;
             }
 
-            nearer = ((ndist = dist2(nx, ny, gx, gy)) < nidist);
-
-            if ((appr == 1 && nearer) || (appr == -1 && !nearer)
